PORT=5000

# Comma-separated list of allowed frontend origins for CORS.
# Falls back to https://shushrutai.vercel.app if unset.
# Include your local dev origin too, e.g.:
# CORS_ORIGIN=https://shushrutai.vercel.app,http://localhost:5173
CORS_ORIGIN=https://shushrutai.vercel.app

# Python AI server base URL (used only by the /api/patients/analyze proxy route).
# The current frontend calls the Python server directly, so this is optional.
# PYTHON_URL=https://your-python-app.onrender.com

